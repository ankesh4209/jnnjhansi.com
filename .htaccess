Options -Indexes

# Custom 404 Error Document so Apache raw white error screen never shows
ErrorDocument 404 /jnnjhansi/404.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /jnnjhansi/

# Auto-redirect common typo / singular routes to plural / actual routes
RewriteRule ^notice\.php$ notices.php [QSA,L,R=301]
RewriteRule ^tender\.php$ tenders.php [QSA,L,R=301]
RewriteRule ^mayor\.php$ mayer.php [QSA,L,R=301]
RewriteRule ^mayers\.php$ mayer.php [QSA,L,R=301]
RewriteRule ^commissioners\.php$ commissioner.php [QSA,L,R=301]
RewriteRule ^smartcity\.php$ smart_city.php [QSA,L,R=301]
RewriteRule ^service\.php$ services.php [QSA,L,R=301]
RewriteRule ^gallary\.php$ gallery.php [QSA,L,R=301]
RewriteRule ^department\.php$ departments.php [QSA,L,R=301]
</IfModule>
