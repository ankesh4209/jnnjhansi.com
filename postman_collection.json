{
  "info": {
    "_postman_id": "jnn-jhansi-api-v1",
    "name": "Nagar Nigam Jhansi - RESTful API & WebServices",
    "description": "Complete production Postman collection for Nagar Nigam Jhansi Municipal Portal & Mobile Applications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/jnnjhansi/api/index.php",
      "type": "string"
    },
    {
      "key": "ws_url",
      "value": "http://localhost/jnnjhansi/webservice.php",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Home & Dashboard",
      "item": [
        {
          "name": "Get Home Dashboard Aggregate",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}?endpoint=home",
              "host": ["{{base_url}}"],
              "query": [
                { "key": "endpoint", "value": "home" }
              ]
            },
            "description": "Fetches all home screen dashboard data including Mayor, Municipal Commissioner, Top 5 Notices, Top 5 Tenders, News, and Quick Counts."
          }
        },
        {
          "name": "Get API Documentation / Catalog",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}?endpoint=help",
              "host": ["{{base_url}}"],
              "query": [
                { "key": "endpoint", "value": "help" }
              ]
            }
          }
        }
      ]
    },
    {
