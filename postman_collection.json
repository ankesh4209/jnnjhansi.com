            "url": {
              "raw": "{{base_url}}?endpoint=notices&page=1&limit=10&search=",
              "host": ["{{base_url}}"],
              "query": [
                { "key": "endpoint", "value": "notices" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" }
